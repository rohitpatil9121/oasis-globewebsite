---
// One page per fault people actually search for — "RO not giving water",
// "why does my RO water taste bad". These answer the question first and ask
// for the job second: a page that only says "call us" ranks for nothing.
import Base from "../../layouts/Base.astro";
import { biz, wa, trust, href } from "../../data/business.js";
import { problems } from "../../data/seo.js";
import { getConfig } from "../../lib/config.js";
import Pic from "../../components/Pic.astro";

export function getStaticPaths() {
  return problems.map((p) => ({ params: { problem: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const cfg = await getConfig();
const waProblem = wa(`Hi, my water purifier problem: ${p.title.toLowerCase()}. Please share the visit charge and availability.`);
const tel = `tel:${biz.tel}`;
const others = problems.filter((x) => x.slug !== p.slug);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [{
      "@type": "Question",
      name: p.q,
      acceptedAnswer: { "@type": "Answer", text: p.intro + " " + p.causes.join(" ") + " " + p.fix },
    }],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: p.title },
    ],
  },
];
---
<Base
  schema={schema}
  title={`${p.title} — What It Usually Is | Oasis Globe Pune`}
  description={`${p.intro} What normally causes it, and what a technician checks. Water purifier service in Wakad, Hinjewadi, Baner and across Pune.`}>
<main>
  <section class="wrap hero" aria-labelledby="hero-h">
    <div class="hero-copy">
      <p class="eyebrow">Purifier problems</p>
      <h1 id="hero-h" class="h-xl">{p.title}</h1>
      <p class="lead">{p.intro}</p>
      <div class="btn-row">
        <a href={waProblem} target="_blank" rel="noopener" data-event="whatsapp_click" class="btn btn-primary">WhatsApp us</a>
        <a href={tel} data-event="call_click" class="btn btn-outline">Call</a>
      </div>
    </div>
    <div class="hero-img"><Pic src="/images/technician-filter.jpg" alt="Technician checking a water purifier" width="1200" height="800" loading="eager" fetchpriority="high" /></div>
  </section>

  <section class="wrap section" aria-labelledby="why-h">
    <div class="head">
      <h2 id="why-h" class="h-md">What it usually turns out to be.</h2>
      <p class="sub">In roughly the order we find them.</p>
    </div>
    <ul class="areas" style="max-width:820px">
      {p.causes.map((c) => <li style="white-space:normal">{c}</li>)}
    </ul>
  </section>

  <section class="wrap section grid-2" aria-labelledby="fix-h" style="align-items:start">
    <h2 id="fix-h" class="h-md">What we<br />actually do.</h2>
    <div>
      <p class="lead" style="margin-bottom:24px">{p.fix}</p>
      <p class="sub">
        Parts, if any are needed, are charged at the prices on our
        <a href={href("/price-list/")} data-event="price_list_click"> spare-parts list</a> —
        and the technician tells you the amount before fitting anything.
      </p>
    </div>
  </section>

  <section class="trust" aria-labelledby="trust-h">
    <div class="wrap trust-head"><h2 id="trust-h" class="eyebrow">Our promise</h2></div>
    <div class="wrap trust-grid">
      {trust(cfg).map((t, i) => <div><span class="num">0{i + 1}</span><h3>{t.title}</h3><p>{t.body}</p></div>)}
    </div>
  </section>

  <section class="wrap section grid-2" aria-labelledby="other-h" style="align-items:end">
    <div>
      <p class="eyebrow">Other problems</p>
      <h2 id="other-h" class="h-lg">Something<br />else wrong?</h2>
    </div>
    <ul class="areas">
      {others.map((x) => <li><a href={href(`/problems/${x.slug}/`)} style="color:inherit">{x.title}</a></li>)}
    </ul>
  </section>

  <section id="contact" class="cta" aria-labelledby="cta-h">
    <div class="wrap">
      <h2 id="cta-h">Want us to look at it?</h2>
      <p class="lead">Tell us the problem. We will do the rest.</p>
      <div class="btn-row">
        <a href={waProblem} target="_blank" rel="noopener" data-event="whatsapp_click" class="btn btn-primary" style="height:52px;padding:0 28px;font-size:16px">WhatsApp us</a>
        <a href={tel} data-event="call_click" class="btn btn-outline" style="height:52px;padding:0 28px;font-size:16px">Call us</a>
      </div>
    </div>
  </section>
</main>
</Base>
