---
import Base from "../../layouts/Base.astro";
import { biz, wa, msgs, href } from "../../data/business.js";
import { rupee } from "../../lib/config.js";
import products from "../../data/products.json";
import Pic from "../../components/Pic.astro";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const name = `${p.brand} ${p.model}`;
const waProduct = wa(msgs.product(name));
const others = products.filter((x) => x.slug !== p.slug).map((x) => x.image);
---
<Base title={`${name} — ${rupee(p.price)} | Oasis Globe`} description={`${name}: ${p.spec}. Price, specifications and installation in Pune. Ask on WhatsApp.`}>
<main class="wrap">
  <a href={href("/#purifiers")} class="back"><span aria-hidden="true">←</span> All purifiers</a>
  <article class="pdp">
    <div class="gallery">
      <div class="main"><Pic src={p.image} alt={name} width="800" height="800" loading="eager" fetchpriority="high" /></div>
      <div class="thumbs">
        <div><Pic src="/images/kitchen-tap.jpg" alt="Tap detail" width="300" height="300" /></div>
        {others.slice(0, 2).map((src) => <div><Pic src={src} alt="" width="300" height="300" /></div>)}
      </div>
    </div>
    <div class="info">
      <p class="eyebrow muted">{p.brand}</p>
      <h1>{p.model}</h1>
      <p class="price">{rupee(p.price)}</p>
      <p class="desc">{p.description}</p>
      <h2 class="eyebrow muted" style="margin-bottom:8px">Specifications</h2>
      <dl>{p.specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      <div class="btn-row">
        <a href={waProduct} target="_blank" rel="noopener" data-event="product_whatsapp_click" class="btn btn-primary">Ask about this purifier <span aria-hidden="true">→</span></a>
        <a href={`tel:${biz.tel}`} data-event="call_click" class="btn btn-outline">Call</a>
      </div>
      <p class="note">Price includes installation in our Pune service area. Confirm current stock on WhatsApp.</p>
    </div>
  </article>
</main>
</Base>
