---
import Base from "../../layouts/Base.astro";
import { href } from "../../data/business.js";
import { rupee } from "../../lib/config.js";
import products from "../../data/products.json";
import Pic from "../../components/Pic.astro";
---
<Base title="Water Purifiers — Price & Specifications | Oasis Globe" description="Kent, Aquaguard, Livpure and Oasis water purifiers with price and specifications. Installed in Pune by Oasis Globe.">
<main class="wrap">
  <section class="section-tight" style="padding-top:64px">
    <div class="head">
      <p class="eyebrow">Purifiers</p>
      <h1 class="h-md">Compare before you buy.</h1>
      <p class="sub" style="margin-top:20px">Price and specifications for every model we sell and install. Ask on WhatsApp for stock and a home visit.</p>
    </div>
    <div class="products">
      {products.map((p) => (
        <article class="product">
          <a href={href(`/purifiers/${p.slug}/`)} data-event="product_view" class="img"><Pic src={p.image} alt={`${p.brand} ${p.model}`} width="600" height="600" /></a>
          <div class="body">
            <span class="brand-tag">{p.brand}</span>
            <h3><a href={href(`/purifiers/${p.slug}/`)}>{p.model}</a></h3>
            <p class="p">{rupee(p.price)}</p>
            <p class="s">{p.spec}</p>
            <a href={href(`/purifiers/${p.slug}/`)} data-event="product_view" class="link">View details <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>
</main>
</Base>
