---
import Base from "../layouts/Base.astro";
import { biz, wa, msgs, services, trust, steps, faq, href } from "../data/business.js";
import { getConfig, rupee } from "../lib/config.js";
import Pic from "../components/Pic.astro";

const cfg = await getConfig();
const waService = wa(msgs.service);
const tel = `tel:${biz.tel}`;
const faqs = faq(cfg);

// A service card's price: live figure from settings when it has one, else the text.
const priceOf = (s) => (s.priceKey && cfg[s.priceKey] != null) ? rupee(cfg[s.priceKey]) : s.priceText;
---
<Base title="Water Purifier Service in Pune | Oasis Globe" description="Water purifier repair, installation and filter change in Pune. Our technicians focus on how clean your water comes out, not on replacing parts. Pay after the work is done.">
<main id="top">
  <section class="wrap hero" aria-labelledby="hero-h">
    <div class="hero-copy">
      <p class="eyebrow">Water purifier service • Pune</p>
      <h1 id="hero-h" class="h-xl">Clean water is our job. Not selling you parts.</h1>
      <p class="lead">Our technicians care about one thing: how clean the water comes out of your purifier. Not how many parts they can replace. You pay only after the work is done.</p>
      <div class="btn-row">
        <a href={waService} target="_blank" rel="noopener" data-event="whatsapp_click" class="btn btn-primary">WhatsApp us</a>
        <a href={tel} data-event="call_click" class="btn btn-outline">Call</a>
      </div>
    </div>
    <div class="hero-img"><Pic src="/images/hero-counter.jpg" alt="Water purifier installed beneath a kitchen counter" width="1067" height="1334" loading="eager" fetchpriority="high" /></div>
  </section>
  <p class="wrap tagline">Pay after service · Free revisit · Our own technicians</p>

  <section class="trust" aria-labelledby="trust-h">
    <div class="wrap trust-head"><h2 id="trust-h" class="eyebrow">Our promise</h2></div>
    <div class="wrap trust-grid">
      {trust(cfg).map((t, i) => <div><span class="num">0{i + 1}</span><h3>{t.title}</h3><p>{t.body}</p></div>)}
    </div>
  </section>

  <section id="services" class="wrap section" aria-labelledby="services-h">
    <div class="head">
      <h2 id="services-h" class="h-md">Services, without the guesswork.</h2>
      <p class="sub">Repair, installation and filter replacement. Fixed visit charge, parts at listed prices.</p>
    </div>
    <div class="cards">
      {services.map((s) => (
        <article class="card">
          <div>
            <h3>{s.name}</h3>
            {s.priceKey && cfg[s.priceKey] != null
              ? <span class="price" data-cfg={s.priceKey} data-prefix="₹">{priceOf(s)}</span>
              : <span class="price">{priceOf(s)}</span>}
          </div>
          <p>{s.body}</p>
          <div class="btn-row" style="gap:20px">
            <a href={wa(s.msg)} target="_blank" rel="noopener" data-event="whatsapp_click" class="link">WhatsApp <span aria-hidden="true">→</span></a>
            {s.link && <a href={href(s.link.href)} data-event="price_list_click" class="link" style="color:var(--muted)">{s.link.text} <span aria-hidden="true">→</span></a>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="how-h">
    <h2 id="how-h" class="h-md" style="margin-bottom:80px">How it works.</h2>
    <ol class="steps">
      {steps.map((st, i) => (
        <li>
          <div class="n"><span>{st.n}</span><span aria-hidden="true">{i < steps.length - 1 ? "→" : ""}</span></div>
          <div><h3>{st.title}</h3><p>{st.body}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap section-tight" aria-labelledby="brands-h">
    <h2 id="brands-h" class="h-md" style="margin-bottom:48px">Brands we service.</h2>
    <ul class="brands">{biz.brands.map((b) => <li>{b}</li>)}</ul>
  </section>

  <section id="purifiers" class="alt" aria-labelledby="prod-h">
    <div class="wrap section grid-2">
      <div>
        <h2 id="prod-h" class="h-md" style="margin-bottom:20px">Looking for a new purifier?</h2>
        <p class="sub" style="margin-bottom:32px;max-width:460px">Kent, Aquaguard, Livpure and Oasis models with price and specifications, installed by us.</p>
        <a href={href("/purifiers/")} data-event="product_view" class="btn btn-ink" style="height:50px;padding:0 24px;font-size:15px;border-radius:9px">See purifiers <span aria-hidden="true">→</span></a>
      </div>
      <a href={href("/purifiers/")} class="img-link" aria-label="See purifiers"><Pic src="/images/ro-home.jpg" alt="RO purifier" width="800" height="533" /></a>
    </div>
  </section>

  <section id="areas" class="wrap section grid-2" aria-labelledby="areas-h" style="align-items:end">
    <div>
      <p class="eyebrow">Service area</p>
      <h2 id="areas-h" class="h-lg">Pune,<br />close to home.</h2>
    </div>
    <ul class="areas">{biz.areas.map((a) => <li>{a}</li>)}</ul>
  </section>

  <section class="wrap section-tight grid-2" aria-labelledby="faq-h" style="align-items:start">
    <h2 id="faq-h" class="h-md">Questions,<br />answered.</h2>
    <div class="faq">
      {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>

  <section id="contact" class="cta" aria-labelledby="cta-h">
    <div class="wrap">
      <h2 id="cta-h">Need purifier service?</h2>
      <p class="lead">Tell us what’s wrong. We’ll take it from there.</p>
      <div class="btn-row">
        <a href={waService} target="_blank" rel="noopener" data-event="whatsapp_click" class="btn btn-primary" style="height:52px;padding:0 28px;font-size:16px">WhatsApp us</a>
        <a href={tel} data-event="call_click" class="btn btn-outline" style="height:52px;padding:0 28px;font-size:16px">Call us</a>
      </div>
    </div>
  </section>
</main>
</Base>
