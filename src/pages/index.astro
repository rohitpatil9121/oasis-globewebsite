---
import Base from "../layouts/Base.astro";
import { biz, wa, msgs, services, trust, faq, href, slug } from "../data/business.js";
import { getConfig, rupee } from "../lib/config.js";
import Pic from "../components/Pic.astro";
import { topics } from "../data/purifiers.js";
import Facts from "../components/Facts.astro";

const cfg = await getConfig();
const waService = wa(msgs.service);
const tel = `tel:${biz.tel}`;
const faqs = faq(cfg);

// A service card's price: live figure from settings when it has one, else the text.
const priceOf = (s) => (s.priceKey && cfg[s.priceKey] != null) ? rupee(cfg[s.priceKey]) : s.priceText;

// Structured data. The FAQ block is the same text that is on the page — Google
// requires that, and it can show the answers directly in the results. The
// services are declared with the areas they are offered in, which is what a
// local search ("RO service in Wakad") is matched against.
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  ...services.map((s) => ({
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: s.name,
    description: s.body,
    provider: { "@type": "LocalBusiness", name: biz.name, telephone: biz.tel },
    areaServed: biz.areas.map((a) => ({ "@type": "Place", name: a + ", Pune" })),
    ...(s.priceKey && cfg[s.priceKey] != null
      ? { offers: { "@type": "Offer", price: cfg[s.priceKey], priceCurrency: "INR" } }
      : {}),
  })),
];
---
<Base schema={schema} title="Water Purifier Service in Pune | RO Repair & Installation | Oasis Globe" description="Water purifier repair, installation and filter change in Wakad, Hinjewadi, Baner and across Pune. Kent, Aquaguard, Pureit and Livpure serviced. Pay after the work is done.">
<main id="top">
  <section class="wrap hero" aria-labelledby="hero-h">
    <div class="hero-copy">
      <p class="eyebrow">Water purifier sales &amp; service • Pune</p>
      <h1 id="hero-h" class="h-xl">Our job is clean water. Not selling you parts.</h1>
      <p class="lead">We sell, build and repair water purifiers. We change a part only if it is really needed.</p>
      <div class="btn-row">
        <a href={waService} target="_blank" rel="noopener" data-event="whatsapp_click" class="btn btn-primary">WhatsApp us</a>
        <a href={tel} data-event="call_click" class="btn btn-outline">Call</a>
      </div>
      <Facts cfg={cfg} />
    </div>
    <div class="hero-img"><Pic src="/images/hero-prospera.jpg" class="focus-top" alt="Oasis Prospera water purifier on a kitchen wall" width="1122" height="1402" loading="eager" fetchpriority="high" /></div>
  </section>

  <section class="wrap section-tight" aria-labelledby="offers-h">
    <h2 id="offers-h" class="eyebrow">What we provide</h2>
    <nav class="topics" aria-labelledby="offers-h">
      {topics.map((t) => <a href={href(t.link)}>{t.name}</a>)}
    </nav>
  </section>

  <section class="trust" aria-labelledby="trust-h">
    <div class="wrap trust-head"><h2 id="trust-h" class="eyebrow">Our promise</h2></div>
    <div class="wrap trust-grid">
      {trust(cfg).map((t, i) => <div><span class="num">0{i + 1}</span><h3>{t.title}</h3><p>{t.body}</p></div>)}
    </div>
  </section>

  <section id="services" class="wrap section" aria-labelledby="services-h">
    <div class="head">
      <h2 id="services-h" class="h-md">Service.</h2>
      <p class="sub">Visit charge is fixed. Parts at our list price.</p>
    </div>
    <div class="cards">
      {services.map((s) => (
        <article class="card">
          <div>
            <h3>{s.name}</h3>
            {s.priceKey && cfg[s.priceKey] != null
              ? <span class="price" data-cfg={s.priceKey} data-prefix="₹">{priceOf(s)}</span>
              : <span class="price">{priceOf(s)}</span>}
          </div>
          <p>{s.body}</p>
          <div class="btn-row" style="gap:20px">
            <a href={wa(s.msg)} target="_blank" rel="noopener" data-event="whatsapp_click" class="link">WhatsApp <span aria-hidden="true">→</span></a>
            {s.link && <a href={href(s.link.href)} data-event="price_list_click" class="link" style="color:var(--muted)">{s.link.text} <span aria-hidden="true">→</span></a>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap section-tight" aria-labelledby="brands-h">
    <h2 id="brands-h" class="h-md" style="margin-bottom:16px">We repair all big brands.</h2>
    <p class="sub" style="margin-bottom:40px">Your brand not here? Send a message, we will tell you.</p>
    <ul class="brand-tiles">
      {biz.brandTiles.map((b) => (
        <li>{b.logo
          ? <img src={href(b.logo)} alt={b.name} height="40" loading="lazy" decoding="async" />
          : <span style={`color:${b.color};${b.style}`}>{b.name}</span>}</li>
      ))}
    </ul>
  </section>

  <section id="areas" class="wrap section grid-2" aria-labelledby="areas-h" style="align-items:end">
    <div>
      <h2 id="areas-h" class="h-md">Areas we cover.</h2>
    </div>
    <ul class="areas">{biz.areas.map((a) => <li><a href={href(`/areas/${slug(a)}/`)} style="color:inherit">{a}</a></li>)}</ul>
  </section>

  <section class="wrap section-tight grid-2" aria-labelledby="faq-h" style="align-items:start">
    <h2 id="faq-h" class="h-md">Common questions.</h2>
    <div class="faq">
      {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>

  <section id="contact" class="cta" aria-labelledby="cta-h">
    <div class="wrap">
      <h2 id="cta-h">Need a purifier or service?</h2>
      <p class="lead">Tell us what you need on WhatsApp.</p>
      <div class="btn-row">
        <a href={waService} target="_blank" rel="noopener" data-event="whatsapp_click" class="btn btn-primary" style="height:52px;padding:0 28px;font-size:16px">WhatsApp us</a>
        <a href={tel} data-event="call_click" class="btn btn-outline" style="height:52px;padding:0 28px;font-size:16px">Call us</a>
      </div>
    </div>
  </section>
</main>
</Base>
