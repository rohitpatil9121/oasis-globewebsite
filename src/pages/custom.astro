---
// Build-your-own purifier. Options live in src/data/custom.json. The page
// shows no prices: the customer picks a build and sends it on WhatsApp, and
// the office quotes the price there.
import Base from "../layouts/Base.astro";
import { biz, href } from "../data/business.js";
import custom from "../data/custom.json";
import Pic from "../components/Pic.astro";

// No prices anywhere on this page — the owner has not given the final list
// yet (23 Sep 2026: "kuch price mat daal abhi, bas contact on WhatsApp").
// The figures stay in custom.json for when he does; nothing reads them.
const options = custom.groups.flatMap((g) => g.options);
const data = { wa: biz.wa, base: href(""), designs: custom.designs, tanks: custom.tanks, cabinets: custom.cabinets, filters: custom.filters, options };
---
<Base title="Make Your Own Water Purifier | Oasis Globe" description="Choose a model, a cabinet look and the filters you need. Send your build on WhatsApp and we tell you the price.">
<main class="wrap">
  <section style="padding-top:64px">
    <div class="cfg-head">
      <p class="eyebrow">Custom purifier</p>
      <h1 class="h-md">Make your own purifier.</h1>
      <p class="sub" style="margin-top:20px">Choose a model, cabinet and filters. Send it on WhatsApp and we tell you the price.</p>
    </div>

    <form class="cfg" id="cfg" onsubmit="return false">
      <div class="cfg-steps">
        <fieldset>
          <legend><span>1</span> Choose a model</legend>
          <div class="cfg-designs">
            {custom.designs.map((d, i) => (
              <label class="opt design">
                <input type="radio" name="design" value={d.id} checked={i === 0} />
                <span class="ph"><Pic src={d.image} alt="" width="400" height="300" /></span>
                <span class="t">{d.name}</span>
                <span class="n">{d.note}</span>
              </label>
            ))}
          </div>
          <p class="cfg-inc">Every model comes with: {custom.included.join(" · ")}</p>
        </fieldset>

        <fieldset>
          <legend><span>2</span> Choose your cabinet look</legend>
          <p class="cfg-hint">The colour and design of the outer cabinet. The purifier inside is the same.</p>
          <div class="cfg-tabs" role="group" aria-label="Tank type">
            <label><input type="radio" name="tank" value="all" checked /><span>All</span></label>
            {custom.tanks.map((t) => (
              <label><input type="radio" name="tank" value={t.id} /><span>{t.name}</span></label>
            ))}
          </div>
          <div class="cfg-cabs">
            {custom.cabinets.map((c, i) => (
              <label class="opt cab" data-tank={c.tank}>
                <input type="radio" name="cabinet" value={c.id} checked={i === 0} />
                <span class="ph"><Pic src={c.image} alt={c.name} width="220" height="150" /></span>
                <span class="t">{c.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend><span>3</span> Choose your filters</legend>
          <p class="cfg-hint">All six are ticked. Untick the ones you do not want.</p>
          <div class="cfg-checks stack">
            {custom.filters.map((f) => (
              <label class="opt line">
                <input type="checkbox" name="filter" value={f.id} checked />
                <span class="txt">
                  <span class="t">{f.name}</span>
                  <span class="n">{f.note}</span>
                  {f.info && <span class="n info">{f.info}</span>}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend><span>4</span> Add extra filters (optional)</legend>
          <div class="cfg-checks">
            {options.map((o) => (
              <label class="opt line">
                <input type="checkbox" name="opt" value={o.id} />
                <span class="txt">
                  <span class="t">{o.name}</span>
                  <span class="n">{o.note}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>
      </div>

      <aside class="cfg-sum" aria-live="polite">
        <div class="ph" id="sum-ph"><Pic src={custom.cabinets[0].image} alt="" width="800" height="600" loading="eager" /></div>
        <p class="eyebrow muted" style="margin:0 0 12px">How your water gets clean</p>
        <ol class="flow" id="sum-flow"></ol>
        <dl id="sum-lines"></dl>
        <a id="sum-wa" href="#" target="_blank" rel="noopener" data-event="custom_whatsapp_click" class="btn btn-primary">Get price on WhatsApp <span aria-hidden="true">→</span></a>
        <p class="note">We tell you the price, the fitting charge and the fitting date on WhatsApp. You pay only after it is fitted and working.</p>
      </aside>
    </form>
  </section>
</main>

<a id="bar-wa" href="#" target="_blank" rel="noopener" data-event="custom_whatsapp_click" class="cfg-bar">
  <span><small>Your build</small><strong id="bar-count"></strong></span>
  <span class="go">Get price on WhatsApp →</span>
</a>
</Base>

<script is:inline define:vars={{ data }}>
  const form = document.getElementById("cfg");
  const ticked = (name, list) => list.filter((x) => form.querySelector(`input[name=${name}][value="${x.id}"]`).checked);

  // The tank buttons only narrow the cabinet list. If the cabinet that was
  // chosen is no longer in the list, the first one shown is chosen instead.
  function applyTank() {
    const want = form.tank.value;
    const cabs = [...form.querySelectorAll(".opt.cab")];
    cabs.forEach((l) => { l.hidden = want !== "all" && l.dataset.tank !== want; });
    const picked = form.querySelector("input[name=cabinet]:checked");
    if (picked.closest(".opt").hidden) cabs.find((l) => !l.hidden).querySelector("input").checked = true;
  }

  function render() {
    form.querySelectorAll(".opt").forEach((l) => l.classList.toggle("on", l.querySelector("input").checked));
    const d = data.designs.find((x) => x.id === form.design.value);
    const cab = data.cabinets.find((x) => x.id === form.cabinet.value);
    const filters = ticked("filter", data.filters);
    const extras = ticked("opt", data.options);
    const list = (xs) => xs.map((x) => x.name).join(", ") || "None";
    const tank = data.tanks.find((t) => t.id === cab.tank).name;

    const img = document.querySelector("#sum-ph img"), src = data.base + cab.image;
    if (!img.src.endsWith(src)) { document.querySelector("#sum-ph source").srcset = src.replace(/\.jpe?g$/i, ".webp"); img.src = src; }
    const stages = [...filters.map((f) => f.stage), ...extras.filter((o) => o.stage).map((o) => o.stage), "Tank"];
    document.getElementById("sum-flow").innerHTML = stages.map((s) => `<li>${s}</li>`).join("");
    document.getElementById("sum-lines").innerHTML = [["Model", d.name], ["Cabinet", cab.name], ["Tank", tank],
      ["Filters", list(filters)], ["Extra filters", list(extras)]]
      .map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join("");
    document.getElementById("bar-count").textContent = d.name + " · " + (filters.length + extras.length) + " filters";

    const msg = ["Hi, I want to make my own Oasis purifier.", `Model: ${d.name}`, `Cabinet: ${cab.name}`, `Tank: ${tank}`,
      `Filters: ${list(filters)}`, `Extra filters: ${list(extras)}`,
      "Please tell me the price."].join("\n");
    const url = `https://wa.me/${data.wa}?text=${encodeURIComponent(msg)}`;
    document.getElementById("sum-wa").href = document.getElementById("bar-wa").href = url;
  }

  form.addEventListener("change", (e) => { if (e.target.name === "tank") applyTank(); render(); });
  render();
</script>
