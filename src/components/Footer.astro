---
import { biz, svc, href, slug } from "../data/business.js";
import { brands, problems } from "../data/seo.js";
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div>
        <a href={href("/")} class="brand" style="margin-bottom:12px"><img src={href("/images/logo.png")} alt="Oasis Globe" width="504" height="144" class="logo" /></a>
        <p class="tag">{biz.tagline}</p>
      </div>
      <div class="links">
        <a href={href("/purifiers/")}>Branded purifiers</a>
        <a href={href("/custom/")}>Custom</a>
        <a href={href("/service/")}>Service</a>
        <a href={href("/price-list/")}>Price list</a>
      </div>
    </div>
    <div class="cols">
      <div>
        <h3>Brands we service</h3>
        {brands.map((b) => <a href={href(`/brands/${b.slug}/`)}>{b.name} service</a>)}
      </div>
      <div>
        <h3>Common problems</h3>
        {problems.map((p) => <a href={href(`/problems/${p.slug}/`)}>{p.title}</a>)}
      </div>
      <div>
        <h3>Areas we cover</h3>
        {biz.areas.map((a) => <a href={href(`/areas/${slug(a)}/`)}>{a}</a>)}
      </div>
    </div>
    <div class="bottom">
      <address>{biz.address} · <a href={biz.map} target="_blank" rel="noopener" data-event="map_click" style="color:var(--ink)">Google Maps</a><br />Purifiers: <a href={`tel:${biz.tel}`} data-event="call_click" style="color:var(--ink)">{biz.phone}</a> · Service: <a href={`tel:${svc.tel}`} data-event="call_click" style="color:var(--ink)">{svc.phone}</a><br />{biz.hours}</address>
      <span>© {new Date().getFullYear()} Oasis Globe</span>
    </div>
  </div>
</footer>
