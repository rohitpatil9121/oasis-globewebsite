---
import { biz, svc, wa, waSvc, msgs, href, isServicePath } from "../data/business.js";
// On service pages the button and the call link go to the service number.
const service = isServicePath(Astro.url.pathname);
const waService = service ? waSvc(msgs.service) : wa(msgs.hello);
const call = service ? svc : biz;
---
<header class="site-header">
  <nav class="wrap" aria-label="Primary">
    <a href={href("/")} class="brand"><img src={href("/images/logo.png")} alt="Oasis Globe" width="504" height="144" class="logo" /></a>
    <div class="nav-links">
      <a href={href("/purifiers/")}>Branded purifiers</a>
      <a href={href("/custom/")}>Custom</a>
      <a href={href("/service/")}>Service</a>
    </div>
    <a href={waService} target="_blank" rel="noopener" data-event="whatsapp_click" class="btn btn-ink">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z"/></svg>WhatsApp
    </a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu">Menu</button>
  </nav>
  <div id="mobile-menu" class="mobile-menu" data-open="false">
    <a href={`tel:${call.tel}`} data-event="call_click" class="small">Call {call.phone}</a>
    <a href={href("/purifiers/")}>Branded purifiers</a>
    <a href={href("/custom/")}>Custom</a>
    <a href={href("/service/")}>Service</a>
  </div>
</header>
<script>
  const btn = document.querySelector(".menu-btn");
  const menu = document.getElementById("mobile-menu");
  const set = (open) => { menu.dataset.open = String(open); btn.setAttribute("aria-expanded", String(open)); btn.textContent = open ? "Close" : "Menu"; };
  btn?.addEventListener("click", () => set(menu.dataset.open !== "true"));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => set(false)));
</script>
