---
// <picture> with a WebP source and the JPG fallback. `src` is the JPG path
// under /public/images; the .webp sits beside it (scripts make both).
const { src, alt, width, height, loading = "lazy", ...rest } = Astro.props;
const webp = src.replace(/\.(jpe?g|png)$/i, ".webp");
---
<picture>
  <source srcset={webp} type="image/webp" />
  <img src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" {...rest} />
</picture>
